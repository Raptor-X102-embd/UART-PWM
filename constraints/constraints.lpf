# ============================================================================
#  constraints.lpf  --  Lattice Preference File for iCESugar-Pro (ECP5)
#  Device: LFE5U-25F-6BG256C
# ============================================================================

# ----------------------------------------------------------------------------
# 1.  CLOCK DEFINITIONS
# ----------------------------------------------------------------------------

# Primary 25 MHz oscillator input
LOCATE COMP "clk" SITE "P6";
FREQUENCY PORT "clk" 25.000 MHz;
IOBUF PORT "clk" IO_TYPE=LVCMOS33;

# ----------------------------------------------------------------------------
# 2.  I/O PIN ASSIGNMENTS
# ----------------------------------------------------------------------------

# Reset button (active low)
LOCATE COMP "rst_n" SITE "L14";
IOBUF PORT "rst_n" IO_TYPE=LVCMOS33 PULLMODE=UP;

# UART pins (connected to USB-CDC via iCELink)
# A9 - UART TX from PC to FPGA (RX input of FPGA)
LOCATE COMP "rx" SITE "A9";
IOBUF PORT "rx" IO_TYPE=LVCMOS33;

# B9 - UART TX from FPGA to PC (TX output of FPGA)
LOCATE COMP "tx" SITE "B9";
IOBUF PORT "tx" IO_TYPE=LVCMOS33;

# PWM output (using on-board red LED for testing)
LOCATE COMP "pwm_out" SITE "B11";
IOBUF PORT "pwm_out" IO_TYPE=LVCMOS33;

# leds for testing 
#LOCATE COMP "rx_valid_led[0]" SITE "P11";
#LOCATE COMP "rx_valid_led[1]" SITE "N12";
#LOCATE COMP "rx_valid_led[2]" SITE "N13";
#LOCATE COMP "rx_valid_led[3]" SITE "M12";
#IOBUF PORT "rx_valid_led[0]" IO_TYPE=LVCMOS33;
#IOBUF PORT "rx_valid_led[1]" IO_TYPE=LVCMOS33;
#IOBUF PORT "rx_valid_led[2]" IO_TYPE=LVCMOS33;
#IOBUF PORT "rx_valid_led[3]" IO_TYPE=LVCMOS33;
#
#LOCATE COMP "tx_done_led[0]" SITE "P12";
#LOCATE COMP "tx_done_led[1]" SITE "P13";
#LOCATE COMP "tx_done_led[2]" SITE "F14";
#LOCATE COMP "tx_done_led[3]" SITE "M13";
#IOBUF PORT "tx_done_led[0]" IO_TYPE=LVCMOS33;
#IOBUF PORT "tx_done_led[1]" IO_TYPE=LVCMOS33;
#IOBUF PORT "tx_done_led[2]" IO_TYPE=LVCMOS33;
#IOBUF PORT "tx_done_led[3]" IO_TYPE=LVCMOS33;

LOCATE COMP "state_led[0]" SITE "P11";
LOCATE COMP "state_led[1]" SITE "N12";
LOCATE COMP "state_led[2]" SITE "N13";
LOCATE COMP "state_led[3]" SITE "M12";
LOCATE COMP "state_led[4]" SITE "K14";
LOCATE COMP "state_led[5]" SITE "J14";
LOCATE COMP "state_led[6]" SITE "H14";
LOCATE COMP "state_led[7]" SITE "G14";
LOCATE COMP "state_led[8]" SITE "F14";
LOCATE COMP "state_led[9]" SITE "P12";
#LOCATE COMP "state_led[10]" SITE "P13";
IOBUF PORT "state_led[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[8]" IO_TYPE=LVCMOS33;
IOBUF PORT "state_led[9]" IO_TYPE=LVCMOS33;
#IOBUF PORT "state_led[10]" IO_TYPE=LVCMOS33;


LOCATE COMP "wstate_led[0]" SITE "P14";
LOCATE COMP "wstate_led[1]" SITE "M13";
LOCATE COMP "wstate_led[2]" SITE "K13";
IOBUF PORT "wstate_led[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "wstate_led[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "wstate_led[2]" IO_TYPE=LVCMOS33;
# ----------------------------------------------------------------------------
# 3.  TIMING CONSTRAINTS
# ----------------------------------------------------------------------------

# Input delay for reset button (debounced)
INPUTDELAY COMP "rst_n" 2.0 NS;

# Output delay for PWM/LED
OUTPUTDELAY COMP "pwm_out" 3.0 NS;

# ----------------------------------------------------------------------------
# 4.  EXCEPTION PATHS
# ----------------------------------------------------------------------------

# Asynchronous reset: disable setup/hold checks
PATH "rst_n" -> "*.D" EXCEPT;
